Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Os componentes internos são carregados apenas pelo PHP.
    RewriteRule ^(?:controllers|database|includes|models|services|views)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "(?i)^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)\.(env|ini|log|md|sql)$">
    Require all denied
</FilesMatch>
